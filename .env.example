# --- Python data sync (supabase/seed.py, supabase/update_season.py) ---
# Lives in .env at repo root. Service key bypasses RLS for writes. Never commit real values.
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_KEY=your_service_role_key

ESPN_LEAGUE_ID=your_espn_league_id
ESPN_S2=your_espn_s2_cookie
ESPN_SWID=your_espn_swid_cookie

# --- Next.js frontend (.env.local) ---
# Publishable (anon) key only — safe to expose to the browser. Read-only via RLS.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_key

# --- Weekly power-rankings submission tool (private) ---
# Secret path segment for /rankings-entry/<secret>. Any random string; the URL
# is the only thing gating the tool, so keep it private. Needed by Next at
# runtime (add to .env.local locally AND to the Vercel project env).
RANKINGS_SUBMIT_SECRET=your_random_secret
# The server action that saves rankings writes with the service role, so the
# frontend also needs SUPABASE_SERVICE_KEY at runtime. It already lives in root
# .env for the Python sync (loaded locally); add it to the Vercel project env too.

# --- League article submissions ---
# /articlessubmit is intentionally ungated: it is unlisted (not in the nav,
# noindex) and the URL is handed out by hand, but anyone who has it can publish.
# No secret to set. It writes with the service role, so the frontend needs
# SUPABASE_SERVICE_KEY at runtime (already required by the rankings tool).

# --- Homepage stats bot ---
# Server-only key for /api/chat, billed per question. Never prefix it with
# NEXT_PUBLIC_. Add to .env.local AND the Vercel project env. The chat box shows
# "isn't set up yet" without it. Set a spend limit on the Anthropic account too:
# the route's rate limits are per server instance, so they're only best-effort.
ANTHROPIC_API_KEY=your_anthropic_api_key

# --- Cache-bust hook for the daily sync ---
# The GitHub Actions sync POSTs to /api/revalidate when it finishes so the site
# drops its cached Supabase reads all at once (otherwise each cached query
# expires on its own clock and pages disagree for up to an hour). Any random
# string; set the SAME value as the Vercel env var REVALIDATE_SECRET and as the
# GitHub repo secret REVALIDATE_SECRET. Also add a GitHub secret SITE_URL
# (e.g. https://www.duckfucks.com). If either GitHub secret is missing the sync
# still runs and just skips the cache clear.
REVALIDATE_SECRET=your_random_secret
